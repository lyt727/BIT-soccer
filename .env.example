# ============ 绿茵BIT 服务端环境变量示例 ============
# 端口
PORT=3000

# 短信验证码
# demo：本地演示，验证码直接返回并自动填入
# tencent / aliyun / webhook：真实短信
SMS_MODE=demo

# ---------------- 腾讯云短信 ----------------
# SMS_MODE=tencent
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_APP_ID=1400xxxxxx
# TENCENT_SMS_SIGN_NAME=北理工足球
# TENCENT_SMS_TEMPLATE_ID=1234567
# TENCENT_SMS_REGION=ap-guangzhou

# ---------------- 阿里云短信 ----------------
# SMS_MODE=aliyun
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=北理工足球
# ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789
# ALIYUN_SMS_REGION_ID=cn-hangzhou

# ---------------- 自建/第三方短信网关 ----------------
# SMS_MODE=webhook
# SMS_WEBHOOK_URL=https://your-gateway.example.com/send
# SMS_WEBHOOK_TOKEN=

# 数据库：sqlite（零依赖演示）或 pg（云数据库 PostgreSQL）
# DB_DRIVER=pg
# DATABASE_URL=postgres://user:pass@host:5432/greensinbit

# 生产必改：JWT 签名密钥
JWT_SECRET=please-change-to-a-long-random-string

# AI 识图（任选其一）：
#   1) 不配置：自动使用“演示识别模式”
#   2) 配置下方三项：启用真实视觉大模型（OpenAI 兼容协议）
#      示例-阿里云百炼：AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                      AI_VISION_MODEL=qwen-vl-max
#      示例-OpenAI：    AI_VISION_BASE_URL=https://api.openai.com/v1
#                      AI_VISION_MODEL=gpt-4o
AI_PROVIDER=auto
AI_VISION_API_KEY=
AI_VISION_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o
